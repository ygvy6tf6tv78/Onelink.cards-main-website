# Razorpay Credentials (Dashboard → Settings → API Keys). Use live keys in production; never commit real secrets.
RAZORPAY_KEY_ID=rzp_live_YourKeyId
RAZORPAY_KEY_SECRET=YourKeySecret

# Booking email alerts (Resend: https://resend.com — create API key, verify sending domain for production).
# Required on Vercel/hosting or /api/booking/notify-details will not send.
RESEND_API_KEY=re_YourResendApiKey
# Where lead + payment notifications go (default: hello@repixelx.tech). Comma-separated for multiple inboxes.
BOOKING_NOTIFY_EMAIL=hello@repixelx.tech
# Must be an address/domain verified in Resend. Production: use your domain (e.g. bookings@onelink.cards).
RESEND_FROM=OneLink Bookings <onboarding@resend.dev>

# Optional application origin for integrations. SEO canonicals and social URLs are
# intentionally pinned to https://getonelink.in in src/lib/seo.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy application-origin alias.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional ownership tokens for search-engine webmaster tools.
# Add the token value only (not the full HTML meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
